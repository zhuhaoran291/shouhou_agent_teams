# 在运行机器上可复制为 `.agentteams.env`，用于记录本次 demo 的关键配置。
#
# demo runner 不会自动读取这个文件；它只是给人看的配置清单。

AT_ELEMENT_WEB_URL=http://127.0.0.1:18088
AT_MANAGER_ROOM=manager
AT_TASK_ROOM=<Team room for aftersales-zero-demo>
AT_TEAM_LEADER=merchant-aftersales-leader
AT_MODEL=qwen-plus
AT_TEAM_NAME=aftersales-zero-demo
MOCK_TOOL_BASE_URL=http://<TOOL_HOST_REACHABLE_BY_WORKER>:18089
